 #    if !defined(__MATH_H__) && !defined(__MATH_H) && !defined(__cmath__)
-#      include <fp.h>
+      /* <fp.h> is a classic-Mac header (pre-OS X era) that Apple removed
+       * from modern macOS SDKs, so it cannot be included when building
