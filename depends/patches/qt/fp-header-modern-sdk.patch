+       * toolchains this branch was written for) keep the old behavior;
+       * on modern compilers, include <fp.h> only when it actually exists
+       * and fall back to <math.h> otherwise.
+       */
+#      if !defined(__has_include)
+#        include <fp.h>
+#      elif __has_include(<fp.h>)
+#        include <fp.h>
+#      else
+#        include <math.h>
+#      endif
